@model ManchesterUnitedApp.Models.Player.PlayerDetailModel

@{
    Layout = "_PlayerLayout";
    ViewData["Title"] = "Delete Player";
}

<h1 class="mb-4 fw-bold text-uppercase text-center">Delete Player</h1>

<h3 class="text-danger text-center">Are you sure you want to delete this player?</h3>
<hr />

<div class="row justify-content-center">
    <div class="col-md-8">
        <dl class="row">
            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3">Age</dt>
            <dd class="col-sm-9">@Model.Age</dd>

            <dt class="col-sm-3">DOB</dt>
            <dd class="col-sm-9">@Model.DOB.ToShortDateString()</dd>

            <dt class="col-sm-3">Nationality</dt>
            <dd class="col-sm-9">@Model.Nationality</dd>

            <dt class="col-sm-3">Height</dt>
            <dd class="col-sm-9">@Model.Height</dd>

            <dt class="col-sm-3">Weight</dt>
            <dd class="col-sm-9">@Model.Weight lb</dd>

            <dt class="col-sm-3">Jersey Number</dt>
            <dd class="col-sm-9">@Model.JerseyNumber</dd>

            <dt class="col-sm-3">Gender</dt>
            <dd class="col-sm-9">@Model.GenderTypeName</dd>

            <dt class="col-sm-3">Team</dt>
            <dd class="col-sm-9">@Model.TeamName</dd>

            <dt class="col-sm-3">Position</dt>
            <dd class="col-sm-9">@Model.PositionName</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@Model.StatusName</dd>

            <dt class="col-sm-3">Created By</dt>
            <dd class="col-sm-9">@Model.CreatedBy</dd>

            <dt class="col-sm-3">Created On</dt>
            <dd class="col-sm-9">@Model.CreatedOn.ToString("g")</dd>

            <dt class="col-sm-3">Photo</dt>
            <dd class="col-sm-9">
                @if (Model.ImageData != null && Model.ImageData.Length > 0)
                {
                    <img src="data:@(Model.ImageType ?? "image/jpeg");base64,@(Convert.ToBase64String(Model.ImageData))"
                         alt="Player photo"
                         class="img-thumbnail"
                         style="max-height:200px;" />
                }
                else
                {
                    <span class="text-muted">No image available</span>
                }
            </dd>
        </dl>

        <!-- ✅ Delete Confirm Form (Only for Admin/SuperAdmin) -->
        @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
        {
            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex justify-content-center gap-3 mt-4">
                    <input type="submit" value="Delete" class="btn btn-danger" />
                    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                </div>
            </form>
        }
        else
        {
            <div class="alert alert-warning text-center mt-4">
                You do not have permission to delete this player.
            </div>
            <div class="text-center mt-3">
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        }
    </div>
</div>