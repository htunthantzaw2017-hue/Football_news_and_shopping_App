@model ManchesterUnitedApp.Models.Player.PlayerDetailModel

@{
    Layout = "_PlayerLayout";
    ViewData["Title"] = Model.Name?.ToUpperInvariant() ?? "Player Details";
}

<div class="container-fluid bg-dark text-white py-5 px-4 rounded shadow">
    <div class="row align-items-center">
        <!-- Left: Quote -->
        <div class="col-md-6">
            <blockquote class="blockquote fs-4 fw-bold text-warning">
                “Playing for Manchester United is a proud honour for every player.”
            </blockquote>
        </div>

        <!-- Right: Player Image -->
        <div class="col-md-6 text-center">
            @if (Model.ImageData != null && Model.ImageData.Length > 0)
            {
                <img src="data:@(Model.ImageType ?? "image/jpeg");base64,@(Convert.ToBase64String(Model.ImageData))"
                     alt="Player photo"
                     class="img-fluid rounded border border-light shadow"
                     style="max-height:400px;" />
            }
            else
            {
                <span class="text-muted">No image available</span>
            }

            <div class="mt-3">
                <a href="/Shop/Index" class="btn btn-danger fw-bold px-4">BUY SHIRT</a>
            </div>
        </div>
    </div>

    <!-- Player Info -->
    <div class="row justify-content-center mt-5">
        <div class="col-md-8">
            <h2 class="text-uppercase fw-bold text-center mb-4">@Model.Name</h2>
            <dl class="row">
                @* <dt class="col-sm-4">Name</dt>
                <dd class="col-sm-8">@Model.Name</dd> *@

                <dt class="col-sm-4">Age</dt>
                <dd class="col-sm-8">@Model.Age</dd>

                @* <dt class="col-sm-4">Date of Birth</dt>
                <dd class="col-sm-8">@Model.DOB.ToShortDateString()</dd> *@

                <dt class="col-sm-4">Nationality</dt>
                <dd class="col-sm-8">@Model.Nationality</dd>

                <dt class="col-sm-4">Height</dt>
                <dd class="col-sm-8">@Model.Height cm</dd>

                <dt class="col-sm-4">Weight</dt>
                <dd class="col-sm-8">@Model.Weight lb</dd>

                <dt class="col-sm-4">Jersey Number</dt>
                <dd class="col-sm-8">@Model.JerseyNumber</dd>

                <dt class="col-sm-4">Gender</dt>
                <dd class="col-sm-8">@Model.GenderTypeName</dd>

                <dt class="col-sm-4">Team</dt>
                <dd class="col-sm-8">@Model.TeamName</dd>

                <dt class="col-sm-4">Position</dt>
                <dd class="col-sm-8">@Model.PositionName</dd>

                <dt class="col-sm-4">Status</dt>
                <dd class="col-sm-8">@Model.StatusName</dd>

                @* <dt class="col-sm-4">Created By</dt>
                <dd class="col-sm-8">@Model.CreatedBy</dd>

                <dt class="col-sm-4">Created On</dt>
                <dd class="col-sm-8">@Model.CreatedOn.ToString("g")</dd> *@
            </dl>
        </div>
    </div>

    <!-- Action Buttons -->
    <div class="row justify-content-center mt-4">
        <div class="col-md-6 d-flex justify-content-center gap-3">
            @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Delete</a>
            }
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </div>
    </div>

</div>