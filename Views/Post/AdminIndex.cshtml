@model IEnumerable<ManchesterUnitedApp.Models.Post.PostListModel>

@{
    ViewData["Title"] = "Index";
}

<h1>Latest News</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New Post</a>
</p>

<hr />

@* START: Use a simple container/row for the card layout instead of a table *@
<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    @foreach (var post in Model)
    {
        <div class="col">
            <div class="card h-100 shadow-sm">

                @* Image Rendering Section *@
                <div class="card-img-top text-center" style="height: 200px; overflow: hidden; background-color: #f8f9fa;">
                    @if (post.ItemImage != null && !string.IsNullOrEmpty(post.ImageType))
                    {
                        <img src="data:@post.ImageType;base64,@Convert.ToBase64String(post.ItemImage)"
                             class="img-fluid"
                             style="height: 100%; width: 100%; object-fit: cover;"
                             alt="@post.Title" />
                    }
                    else
                    {
                        <div class="d-flex align-items-center justify-content-center h-100 border-bottom text-muted">
                            <small>🖼️ No Image</small>
                        </div>
                    }
                </div>

                @* Card Body Section *@
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title text-primary">@Html.DisplayFor(modelPost => post.Title)</h5>
                    <h6 class="card-subtitle mb-2 text-muted">Category: @Html.DisplayFor(modelPost => post.CategoryName)</h6>

                    @* Content now in a readonly textarea *@
                    <textarea class="form-control flex-grow-1 mb-2"
                          readonly
                          style="resize: none; min-height: 80px; max-height: 120px; overflow-y: auto;">
@post.Content
                    </textarea>

                    <ul class="list-group list-group-flush mt-2">
                        <li class="list-group-item p-1">Status: <span class="badge bg-secondary">@Html.DisplayFor(modelPost => post.PostStatusName)</span></li>
                        <li class="list-group-item p-1">Created By: <span class="text-sm">@Html.DisplayFor(modelPost => post.CreatedBy)</span></li>
                    </ul>
                </div>

                @* Card Footer Actions *@
                <div class="card-footer bg-light d-flex justify-content-between">
                    <a asp-action="Details" asp-route-id="@post.Id" class="btn btn-sm btn-outline-info">Details</a>

                    @if (User.Identity.IsAuthenticated &&
                                    (User.Identity.Name == post.CreatedBy || User.Identity.Name == "superadmin@mail.com"))
                    {
                        <div>
                            <a asp-action="Edit" asp-route-id="@post.Id" class="btn btn-sm btn-warning me-2">Edit</a>
                            <a asp-action="Delete" asp-route-id="@post.Id" class="btn btn-sm btn-danger">Delete</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>
@* END: Row container *@
