@model ManchesterUnitedApp.Models.Account.LoginModel
@{
    ViewData["Title"] = "Login";
}

<style>
    /* 🎨 Styling for the Red Theme */
    .themed-container {
        /* Removes potential background image settings */
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

    .login-card {
        background-color: #ffffff;
        border: 2px solid #DA291C; /* Man U Red border */
        box-shadow: 0 6px 15px rgba(0, 0, 0, 0.1); /* Slightly deeper shadow */
        border-radius: 12px; /* Slightly more rounded corners */
    }

    .btn-manutd-red {
        background-color: #DA291C; /* Man U Red */
        border-color: #DA291C;
        color: #ffffff;
        transition: background-color 0.3s;
    }

        .btn-manutd-red:hover {
            background-color: #A31E17; /* Darker Red on hover */
            border-color: #A31E17;
            color: #ffffff;
        }

    .mu-text-red {
        color: #DA291C; /* Man U Red text */
        font-weight: 700;
    }
</style>

<div class="themed-container">
    <div class="col-md-5 col-lg-4">
        <div class="login-card p-4 p-md-5">
            <section>

                @* <h1> Title replaces the logo for primary branding </h1> *@
                @* <h1 class="text-center mb-2 mu-text-red">MAN UTD LOGIN</h1> *@
                <p class="text-center text-muted mb-4">Welcome back to the fan community.</p>

                <form asp-controller="Account" asp-action="Login" method="post">
                    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                    <hr class="mb-4" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    @* Email Input *@
                    <div class="form-floating mb-3">
                        <input asp-for="Email" class="form-control" autocomplete="username" aria-required="true" />
                        <label asp-for="Email">Email Address</label>
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    @* Password Input with Toggle *@
                    <div class="form-floating mb-3 position-relative">
                        <input asp-for="Password" class="form-control" id="passwordBox" autocomplete="current-password" aria-required="true" />
                        <label asp-for="Password">Password</label>
                        <span asp-validation-for="Password" class="text-danger"></span>

                        <button type="button" class="btn btn-sm btn-outline-secondary position-absolute top-50 end-0 translate-middle-y me-2" onclick="togglePassword()" tabindex="-1" style="border: none;">
                            <i class="fa fa-eye" id="eyeIcon"></i>
                        </button>
                    </div>

                    @* Remember Me Checkbox *@
                    <div class="form-check mb-4">
                        <input class="form-check-input" asp-for="RememberMe" />
                        <label class="form-check-label" asp-for="RememberMe">
                            @Html.DisplayNameFor(m => m.RememberMe)
                        </label>
                    </div>

                    @* Login Button *@
                    <div>
                        <button type="submit" class="w-100 btn btn-lg btn-manutd-red">
                            <i class="fa fa-sign-in-alt me-2"></i> Log in
                        </button>
                    </div>

                    @* Additional Links *@
                    <div class="mt-3 text-center">
                        <p class="mb-1">
                            <a asp-controller="Account" asp-action="Register" class="text-decoration-none mu-text-red">
                                Register as a new user
                            </a>
                        </p>
                        <p class="mb-0">
                            <a asp-action="ForgotPassword" class="text-muted text-decoration-none">
                                Forgot your password?
                            </a>
                        </p>
                    </div>
                </form>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function togglePassword() {
            const passwordBox = document.getElementById("passwordBox");
            const eyeIcon = document.getElementById("eyeIcon");

            if (passwordBox.type === "password") {
                passwordBox.type = "text";
                eyeIcon.classList.remove("fa-eye");
                eyeIcon.classList.add("fa-eye-slash");
            } else {
                passwordBox.type = "password";
                eyeIcon.classList.remove("fa-eye-slash");
                eyeIcon.classList.add("fa-eye");
            }
        }
    </script>
}