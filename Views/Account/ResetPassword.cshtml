@model ManchesterUnitedApp.Models.Account.ResetPasswordViewModel;

<h2>Reset Password</h2>

<form method="post">
    <input type="hidden" asp-for="Token" />
    <input type="hidden" asp-for="Email" />

    <div class="form-floating mb-3 position-relative">
        <input asp-for="Password" class="form-control" id="resetPasswordBox" placeholder="New Password" />
        <label asp-for="Password" class="form-label">New Password</label>
        <span asp-validation-for="Password" class="text-danger"></span>

        <button type="button" class="btn btn-sm btn-outline-secondary position-absolute top-50 end-0 translate-middle-y me-2" onclick="toggleResetPassword()" tabindex="-1">
            <i class="fa fa-eye" id="resetEyeIcon"></i>
        </button>
    </div>

    <div class="mb-3">
        <input asp-for="ConfirmPassword" class="form-control" placeholder="Confirm Password" />
        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">Reset Password</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function toggleResetPassword() {
            const box = document.getElementById("resetPasswordBox");
            const icon = document.getElementById("resetEyeIcon");
            toggleVisibility(box, icon);
        }

        function toggleVisibility(box, icon) {
            if (box.type === "password") {
                box.type = "text";
                icon.classList.remove("fa-eye");
                icon.classList.add("fa-eye-slash");
            } else {
                box.type = "password";
                icon.classList.remove("fa-eye-slash");
                icon.classList.add("fa-eye");
            }
        }
    </script>
}

