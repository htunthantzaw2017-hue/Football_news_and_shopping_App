@model ManchesterUnitedApp.Controllers.MatchesIndexViewModel

@{
    ViewData["Title"] = "Match Center";
}

<style>
    /* Team Box Styles */
    .team-box {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 100px;
    }

    .team-logo-lg {
        width: 64px;
        height: 64px;
        object-fit: contain;
        margin-bottom: 8px;
        filter: drop-shadow(0px 4px 4px rgba(0,0,0,0.1));
    }

    .team-logo-sm {
        width: 30px;
        height: 30px;
        object-fit: contain;
        margin: 0 8px;
        vertical-align: middle;
    }

    .vs {
        font-size: 1.5rem;
        color: #dc3545; /* Bootstrap danger color */
        font-style: italic;
    }

    .score-box {
        background-color: #e9ecef;
        padding: 5px 15px;
        border-radius: 20px;
        font-weight: bold;
        font-size: 1.1rem;
        min-width: 80px;
    }

    .match-date {
        font-size: 0.85rem;
        color: #6c757d;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .card-hover:hover {
        transform: translateY(-5px);
        transition: transform 0.3s ease;
        box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
    }

   @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
{
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus-circle me-1"></i> Create New Match
    </a>
}

</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="fw-bold">Match Center</h1>
        <p class="text-muted"></p>
    </div>

    @* Only admins see Create button *@
    @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
    {
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus-circle me-1"></i> Create New Match
        </a>
    }
</div>


    <div class="card mb-5 border-0 shadow-sm">
        <div class="card-header bg-danger text-white py-3">
            <h4 class="mb-0"><i class="far fa-calendar-alt me-2"></i>Upcoming Matches</h4>
        </div>
        <div class="card-body bg-light">
            @if (Model.UpcomingMatches != null && Model.UpcomingMatches.Any())
            {
                <div class="row">
                    @foreach (var item in Model.UpcomingMatches)
                    {
                        <div class="col-md-6 col-lg-4 mb-4">
                            <div class="card h-100 border-0 shadow-sm card-hover">
                                <div class="card-body text-center p-4">
                                    <div class="match-date mb-3">@Html.DisplayFor(m => item.MatchDate)</div>
                                    <div class="d-flex justify-content-center align-items-center">
                                        <div class="team-box">
                                            <img src="@item.HomeTeamLogoPath" class="team-logo-lg" alt="Home Logo" onerror="this.onerror=null; this.src='/images/default-logo.png';" />
                                            <div class="fw-bold">@Html.DisplayFor(m => item.HomeTeamName)</div>
                                        </div>
                                        <div class="vs mx-3">VS</div>
                                        <div class="team-box">
                                            <img src="@item.AwayTeamLogoPath" class="team-logo-lg" alt="Away Logo" onerror="this.onerror=null; this.src='/images/default-logo.png';" />
                                            <div class="fw-bold">@Html.DisplayFor(m => item.AwayTeamName)</div>
                                        </div>
                                    </div>
                                    <div class="mt-3 badge bg-warning text-dark"></div>
                                </div>
                               
                                <div class="card-footer bg-white border-top-0 text-center pb-3 admin-only">
                                    <div class="btn-group btn-group-sm">
                                        @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
                                        {
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary"><i class="fas fa-edit"></i> Edit</a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger"><i class="fas fa-trash"></i> Delete</a>
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info"><i class="fas fa-info-circle"></i> Details</a>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="alert alert-info">No upcoming matches scheduled.</p>
            }
        </div>
    </div>

    <div class="card shadow-sm mb-5">
        <div class="card-header bg-dark text-white py-3">
            <h4 class="mb-0"><i class="fas fa-history me-2"></i>Match Results</h4>
        </div>
        <div class="card-body p-0">
            @if (Model.MatchResults != null && Model.MatchResults.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover table-striped mb-0 align-middle">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4">Date</th>
                                <th class="text-end" style="width: 35%;">Home</th>
                                <th class="text-center" style="width: 15%;">Score</th>
                                <th class="text-start" style="width: 35%;">Away</th>
                                @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
                                                {
                                    <th class="text-end pe-4">Actions</th>
                                }
                                
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.MatchResults)
                            {
                                <tr>
                                    <td class="ps-4 text-muted">@Html.DisplayFor(m => item.MatchDate)</td>
                                    <td class="text-end fw-bold">
                                        @Html.DisplayFor(m => item.HomeTeamName)
                                        <img src="@item.HomeTeamLogoPath" class="team-logo-sm" alt="Home Logo" onerror="this.onerror=null; this.src='/images/default-logo.png';" />
                                    </td>
                                    <td class="text-center">
                                        <span class="score-box">@item.HomeScore - @item.AwayScore</span>
                                    </td>
                                    <td class="text-start fw-bold">
                                        <img src="@item.AwayTeamLogoPath" class="team-logo-sm" alt="Away Logo" onerror="this.onerror=null; this.src='/images/default-logo.png';" />
                                        @Html.DisplayFor(m => item.AwayTeamName)
                                    </td>
                                    <td class="text-end pe-4">
                                     @* Everyone can see stats/details link if you want *@
                                    @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
                                                {
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning"><i class="fas fa-pencil"></i></a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></a>
                                }
                            </td>

                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="p-3 alert alert-secondary mb-0">No match results available yet.</p>
            }
        </div>
    </div>
</div>