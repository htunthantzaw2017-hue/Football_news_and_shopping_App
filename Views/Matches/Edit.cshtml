@model ManchesterUnitedApp.Models.ViewModel.MatchCreateViewModel

@{
    ViewData["Title"] = "Edit Match";
}

<div class="card shadow-lg p-4">
    <h3 class="fw-bold mb-4 text-center">Edit Match (Admin)</h3>
    <hr />

    <form asp-action="Edit" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="row">
            <!-- Home Team -->
            <div class="col-md-6 border-end">
                <h5 class="text-success text-center mb-3"><i class="fas fa-home me-2"></i>Home Team</h5>

                <div class="form-group mb-3">
                    <label asp-for="HomeTeamName" class="form-label fw-bold"></label>
                    <input asp-for="HomeTeamName" class="form-control" />
                    <span asp-validation-for="HomeTeamName" class="text-danger small"></span>
                </div>

                <div class="form-group mb-3">
                    <label class="form-label">Current Logo</label>
                    @* @if (!string.IsNullOrEmpty(Model.HomeTeamLogoPath))
                    {
                        <img src="@Model.HomeTeamLogoPath" class="img-fluid mb-2" style="max-height:120px;" />
                    } *@
                    <label asp-for="HomeLogoFile" class="form-label">Upload New Logo</label>
                    <input asp-for="HomeLogoFile" type="file" accept=".jpg,.jpeg,.png,.gif" class="form-control" />
                    <span asp-validation-for="HomeLogoFile" class="text-danger small"></span>
                    <img id="homeLogoPreview" src="#" class="img-fluid mt-2 d-none" style="max-height:120px;" />
                </div>

                <div class="form-group mb-3">
                    <label asp-for="HomeScore" class="form-label">Score</label>
                    <input asp-for="HomeScore" type="number" class="form-control" />
                    <span asp-validation-for="HomeScore" class="text-danger small"></span>
                </div>
            </div>

            <!-- Away Team -->
            <div class="col-md-6">
                <h5 class="text-primary text-center mb-3"><i class="fas fa-plane-departure me-2"></i>Away Team</h5>

                <div class="form-group mb-3">
                    <label asp-for="AwayTeamName" class="form-label fw-bold"></label>
                    <input asp-for="AwayTeamName" class="form-control" />
                    <span asp-validation-for="AwayTeamName" class="text-danger small"></span>
                </div>

                <div class="form-group mb-3">
                    <label class="form-label">Current Logo</label>
                    @* @if (!string.IsNullOrEmpty(Model.AwayTeamLogoPath))
                    {
                        <img src="@Model.AwayTeamLogoPath" class="img-fluid mb-2" style="max-height:120px;" />
                    } *@
                    <label asp-for="AwayLogoFile" class="form-label">Upload New Logo</label>
                    <input asp-for="AwayLogoFile" type="file" accept=".jpg,.jpeg,.png,.gif" class="form-control" />
                    <span asp-validation-for="AwayLogoFile" class="text-danger small"></span>
                    <img id="awayLogoPreview" src="#" class="img-fluid mt-2 d-none" style="max-height:120px;" />
                </div>

                <div class="form-group mb-3">
                    <label asp-for="AwayScore" class="form-label">Score</label>
                    <input asp-for="AwayScore" type="number" class="form-control" />
                    <span asp-validation-for="AwayScore" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <hr class="my-4" />

        <div class="form-group mb-3">
            <label asp-for="MatchDate" class="form-label fw-bold">Match Date & Time</label>
            <input asp-for="MatchDate" type="datetime-local" class="form-control" />
            <span asp-validation-for="MatchDate" class="text-danger small"></span>
        </div>

        <div class="form-check mb-4">
            <input class="form-check-input" asp-for="IsFinished" />
            <label class="form-check-label" asp-for="IsFinished">@Html.DisplayNameFor(m => m.IsFinished)?</label>
        </div>

        <div class="form-group d-grid">
            <input type="submit" value="Save Changes" class="btn btn-primary btn-lg" />
        </div>
    </form>
</div>

<div class="mt-4">
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-1"></i>Back to List</a>
</div>

@section Scripts {
    <script>
        // Home logo preview
        const homeInput = document.getElementById("HomeLogoFile");
        const homePreview = document.getElementById("homeLogoPreview");
        homeInput.addEventListener("change", function () {
            if (this.files && this.files[0]) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    homePreview.src = e.target.result;
                    homePreview.classList.remove("d-none");
                }
                reader.readAsDataURL(this.files[0]);
            }
        });

        // Away logo preview
        const awayInput = document.getElementById("AwayLogoFile");
        const awayPreview = document.getElementById("awayLogoPreview");
        awayInput.addEventListener("change", function () {
            if (this.files && this.files[0]) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    awayPreview.src = e.target.result;
                    awayPreview.classList.remove("d-none");
                }
                reader.readAsDataURL(this.files[0]);
            }
        });
    </script>

    @await Html.PartialAsync("_ValidationScriptsPartial")
}
