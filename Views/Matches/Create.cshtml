@model ManchesterUnitedApp.Models.ViewModel.MatchCreateViewModel

@{
    ViewData["Title"] = "Create";
}

<div class="card shadow-lg p-4">
    <h3 class="fw-bold mb-4 text-center">Create New Match (Admin)</h3>
    <hr />

    <form asp-action="Create" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div class="row">
            <!-- Home Team -->
            <div class="col-md-6 border-end">
                <h5 class="text-success text-center mb-3"><i class="fas fa-home me-2"></i>Home Team Details</h5>

                <div class="form-group mb-3">
                    <label asp-for="HomeTeamName" class="form-label fw-bold"></label>
                    <input asp-for="HomeTeamName" class="form-control" placeholder="Enter Home Team Name" />
                    <span asp-validation-for="HomeTeamName" class="text-danger small"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="HomeLogoFile" class="form-label">Upload Home Logo</label>
                    <input asp-for="HomeLogoFile" type="file" accept=".jpg,.jpeg,.png,.gif" class="form-control" />
                    <span asp-validation-for="HomeLogoFile" class="text-danger small"></span>

                    <!-- Optional preview -->
                    <img id="homeLogoPreview" src="#" alt="Home Logo Preview" class="img-fluid mt-2 d-none" style="max-height: 120px;" />
                </div>

                <div class="form-group mb-3">
                    <label asp-for="HomeScore" class="form-label">Score (Input if Finished)</label>
                    <input asp-for="HomeScore" type="number" class="form-control" placeholder="Optional Score" />
                    <span asp-validation-for="HomeScore" class="text-danger small"></span>
                </div>
            </div>

            <!-- Away Team -->
            <div class="col-md-6">
                <h5 class="text-primary text-center mb-3"><i class="fas fa-plane-departure me-2"></i>Away Team Details</h5>

                <div class="form-group mb-3">
                    <label asp-for="AwayTeamName" class="form-label fw-bold"></label>
                    <input asp-for="AwayTeamName" class="form-control" placeholder="Enter Away Team Name" />
                    <span asp-validation-for="AwayTeamName" class="text-danger small"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="AwayLogoFile" class="form-label">Upload Away Logo</label>
                    <input asp-for="AwayLogoFile" type="file" accept=".jpg,.jpeg,.png,.gif" class="form-control" />
                    <span asp-validation-for="AwayLogoFile" class="text-danger small"></span>

                    <!-- Optional preview -->
                    <img id="awayLogoPreview" src="#" alt="Away Logo Preview" class="img-fluid mt-2 d-none" style="max-height: 120px;" />
                </div>

                <div class="form-group mb-3">
                    <label asp-for="AwayScore" class="form-label">Score (Input if Finished)</label>
                    <input asp-for="AwayScore" type="number" class="form-control" placeholder="Optional Score" />
                    <span asp-validation-for="AwayScore" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <hr class="my-4" />

        <div class="row">
            <div class="col-12">
                <div class="form-group mb-3">
                    <label asp-for="MatchDate" class="form-label fw-bold"><i class="far fa-clock me-2"></i>Match Date & Time</label>
                    <input asp-for="MatchDate" type="datetime-local" class="form-control" asp-format="{0:yyyy-MM-ddTHH:mm}" />
                    <span asp-validation-for="MatchDate" class="text-danger small"></span>
                </div>

                <div class="form-group form-check mb-4">
                    <input class="form-check-input" type="checkbox" asp-for="IsFinished" />
                    <label class="form-check-label" asp-for="IsFinished">@Html.DisplayNameFor(model => model.IsFinished)?</label>
                </div>
            </div>
        </div>

        <div class="form-group d-grid">
            <input type="submit" value="Create Match" class="btn btn-primary btn-lg" />
        </div>
    </form>
</div>

<div class="mt-4">
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-1"></i> Back to List</a>
</div>

@section Scripts {
    <script>
        // Home logo preview
        const homeInput = document.getElementById("HomeLogoFile");
        const homePreview = document.getElementById("homeLogoPreview");
        homeInput.addEventListener("change", function () {
            if (this.files && this.files[0]) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    homePreview.src = e.target.result;
                    homePreview.classList.remove("d-none");
                }
                reader.readAsDataURL(this.files[0]);
            }
        });

        // Away logo preview
        const awayInput = document.getElementById("AwayLogoFile");
        const awayPreview = document.getElementById("awayLogoPreview");
        awayInput.addEventListener("change", function () {
            if (this.files && this.files[0]) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    awayPreview.src = e.target.result;
                    awayPreview.classList.remove("d-none");
                }
                reader.readAsDataURL(this.files[0]);
            }
        });
    </script>

    @await Html.PartialAsync("_ValidationScriptsPartial")
}
